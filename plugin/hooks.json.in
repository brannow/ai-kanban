{
  "description": "ai-kanban board memory: a briefing at session start, and recorded notes for the files a tool touches.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"@BIN@\" ] && \"@BIN@\" hook session-start || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"@BIN@\" ] && \"@BIN@\" hook post-tool-use || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
