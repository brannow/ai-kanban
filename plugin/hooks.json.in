{
  "_comment": "GENERATED by `make install` from plugin/hooks.json.in -- edit the template, not this. The binary path is baked in; the [ -x ] guard keeps hooks silent if it is ever moved, because a hook that complains is a hook the user deletes.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"@BIN@\" ] && \"@BIN@\" hook session-start || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"@BIN@\" ] && \"@BIN@\" hook post-tool-use || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
