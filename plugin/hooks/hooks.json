{
  "description": "ai-kanban board memory: a briefing at session start, and recorded notes for the files a tool touches.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ai-kanban\" hook session-start 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ai-kanban\" hook post-tool-use 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
