#!/bin/sh
# Locate the ai-kanban binary, then hand off to it unchanged.
#
# Why this exists: hooks.json and mcp.json used to name
# ${CLAUDE_PLUGIN_ROOT}/../../../target/release/ai-kanban directly, which only resolves
# when the plugin sits inside an ai-kanban checkout. Copied anywhere else -- which is how
# a plugin is normally installed -- both the hooks and the MCP server pointed at nothing.
#
# Naming a bare `ai-kanban` on PATH was tried instead and reverted: PATH does not always
# contain the cargo bin directory (rust installed via Homebrew is one such setup), so that
# traded a narrow breakage for a total one. Hence a search rather than a single guess.
#
# Failure is silent for `hook` and explained for everything else. A hook that complains is
# a hook the user deletes, taking the bundled MCP server with it; an MCP server that dies
# with no reason is a board that is mysteriously absent.

set -u

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# The checkout this plugin may be living inside. Deliberately ahead of PATH: while
# developing ai-kanban the local build is the one you mean, and a global install would
# silently shadow the change you are testing.
#
# The named directories below are searched explicitly rather than left to PATH, because a
# hook is not a login shell: the host may invoke it with a minimal PATH that has none of
# them. Anything a user is told to install into has to be on this list, or the plugin works
# in their terminal and silently not in their session.
checkout=$plugin_root/../../..

bin=
for candidate in \
    "${AI_KANBAN_BIN:-}" \
    "$checkout/target/release/ai-kanban" \
    "$checkout/target/debug/ai-kanban" \
    "$HOME/.local/bin/ai-kanban" \
    "$HOME/.cargo/bin/ai-kanban" \
    /opt/homebrew/bin/ai-kanban \
    /usr/local/bin/ai-kanban
do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        bin=$candidate
        break
    fi
done

# PATH last, and only if it does not point back here: if the plugin's own bin directory is
# on PATH, `command -v` finds this script and re-executing it would loop forever.
if [ -z "$bin" ]; then
    found=$(command -v ai-kanban 2>/dev/null) || found=
    if [ -n "$found" ] && [ -x "$found" ]; then
        found_dir=$(CDPATH= cd -- "$(dirname -- "$found")" && pwd)
        [ "$found_dir" = "$plugin_root/bin" ] || bin=$found
    fi
fi

if [ -z "$bin" ]; then
    if [ "${1:-}" = "hook" ]; then
        exit 0
    fi
    echo "ai-kanban: binary not found." >&2
    echo "Install it with \`cargo install --path .\` from an ai-kanban checkout," >&2
    echo "or point AI_KANBAN_BIN at the binary." >&2
    exit 127
fi

exec "$bin" "$@"
